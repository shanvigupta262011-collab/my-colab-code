        "print('--- AI drone proximity radar system ---')\n",
        "\n",
        "# start a loop that runs continuously\n",
        "while True:\n",
        "  # simulating a sensor reading distance to the next object\n",
        "  distance = float(input('sensor scan: enter distance to obstacle (in meters): '))\n",
        "\n",
        "  # The ai decision loop\n",
        "  if distance <= 0:\n",
        "     print(' CRITICAL ERROR: sensor reading invalid. manual override required!')\n",
        "     break # this exits the loop completely\n",
        "\n",
        "  elif distance < 5:\n",
        "      print(' EMERGENCY BRAKE ENGAGED! obstacle too close. system halting.')\n",
        "      break # this breaks the loop to protect the vehicle\n",
        "\n",
        "  else:\n",
        "      print(f' PATH CLEAR: Distance is {distance}m. continuing autonomous flight ...\\n')"
      ]
