      ],
      "source": [
        "print('--- AI real-time motion analytics control ---')\n",
        "\n",
        "total_displacement = 0.0\n",
        "total_time = 0.0\n",
        "\n",
        "while True:\n",
        "  print(f'current status: {total_displacement}m traveled in {total_time}s.')\n",
        "\n",
        "  # input displacement for the last 1-second interval\n",
        "  step_displacement = float(input('enter displacement for the last 1 second (or 0 to stop): '))\n",
        "\n",
        "  # check if the vehicle has come to a final stop\n",
        "  if step_displacement == 0:\n",
        "    print(' /n journey complete. finalizing data analytics stream...')\n",
        "    break\n",
        "\n",
        "  # validation: displacement cannot be negative if moving in a single tracking vector\n",
        "  if step_displacement < 0:\n",
        "    print('WARNING: negative displacement interval detected. skipping data packet. /n')\n",
        "    continue # this skips the rest of the loop and starts the next iteration\n",
        "\n",
        "  # update our systems totals\n",
        "  total_displacement = total_displacement + step_displacement\n",
        "  total_time = total_time + 1.0\n",
        "\n",
        "# post loop final calculation\n",
        "if total_time > 0:\n",
        "  average_velocity = total_displacement / total_time\n",
        "  print(f' ANALYSIS COMPLETE: total displacemet = {total_displacement}m | average velocity = {average_velocity} m/s')\n",
        "else:\n",
        "  print(' SYSTEM INFO: no motion log data recorded.')\n"
